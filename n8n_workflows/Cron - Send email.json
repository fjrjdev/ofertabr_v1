        "jsCode": "const allItems = $input.all();\n\nconst randomIndex = Math.floor(Math.random() * allItems.length);\n\nconst titulo = allItems[randomIndex].json.output.trim();\n\nreturn {\n  json: {\n    titulo: titulo,\n    index_selecionado: randomIndex,\n    total_opcoes: allItems.length\n  }\n};"
